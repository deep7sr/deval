# Copy to .env and fill in your real key. .env is gitignored.
GROQ_API_KEY=gsk_your_key_here

# --- Postgres (test stack). Defaults are fine for local use; override to taste.
# POSTGRES_USER=llmproxy
# POSTGRES_PASSWORD=llmproxy_pw
# POSTGRES_DB=litellm

# --- Optional guardrail tuning (defaults shown; uncomment to override) ---
# GUARDRAIL_MODE=remediate                 # block | remediate
# GUARDRAIL_JUDGE_MODEL=groq/llama-3.3-70b-versatile
# GUARDRAIL_FAITHFULNESS_THRESHOLD=0.7
# GUARDRAIL_MAX_RETRIES=3
# GUARDRAIL_RETRY_TIME_BUDGET_SECONDS=30
# GUARDRAIL_RETRY_TEMPERATURE=0.3
# GUARDRAIL_SSL_VERIFY=false
# GUARDRAIL_EVIDENCE_MARKER=--- Retrieved Evidence ---
